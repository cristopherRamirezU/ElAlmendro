# TimeFlow - .env de PRODUCCION (va en /var/www/timeflow/.env, NUNCA al repo).
# Copiar y reemplazar cada CAMBIAR_* por un valor generado, por ejemplo:
#   openssl rand -hex 24

# Capa de datos - PostgreSQL 16 (solo accesible desde el propio VPS)
BIND_ADDR=127.0.0.1
POSTGRES_USER=timeflow
POSTGRES_PASSWORD=CAMBIAR_PG
POSTGRES_DB=timeflow
POSTGRES_PORT=5432
DATABASE_URL="postgresql://timeflow:CAMBIAR_PG@127.0.0.1:5432/timeflow?schema=public"

# Capa de archivos - MinIO (solo lo usa la API; el navegador nunca lo ve)
MINIO_ROOT_USER=timeflow
MINIO_ROOT_PASSWORD=CAMBIAR_MINIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=timeflow-evidencias
S3_ACCESS_KEY=timeflow
S3_SECRET_KEY=CAMBIAR_MINIO
S3_REGION=us-east-1

# Capa de negocio - API NestJS
API_PORT=4000
# Secreto de las sesiones: 32+ caracteres al azar (openssl rand -hex 32).
# Cambiarlo cierra la sesion de todos.
JWT_ACCESS_SECRET=CAMBIAR_JWT_ACCESS
JWT_REFRESH_SECRET=CAMBIAR_JWT_REFRESH
# Tiempo maximo SIN USAR la app antes de pedir ingresar de nuevo. Mientras
# se use, la sesion se renueva sola. "indefinido" ya no existe (queda en 30d).
JWT_ACCESS_TTL=30d
JWT_REFRESH_TTL=7d
APP_TIMEZONE=America/Santiago
SESION_UMBRAL_AUTOCIERRE_HORAS=10

# Capa de interfaz - Web Next.js
# El navegador llama a la API por el MISMO origen (Caddy enruta /api y
# /socket.io al puerto 4000): asi la cookie httpOnly viaja sin CORS ni
# problemas de SameSite. NEXT_PUBLIC_WEB_URL es el origen permitido por CORS.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://timeflows.site
NEXT_PUBLIC_WEB_URL=https://timeflows.site

# Herramientas (adminer no se levanta en produccion)
ADMINER_PORT=8080
